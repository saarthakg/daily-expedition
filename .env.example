# Copy to .env for local development with `netlify dev`.
# On Netlify, set these in Site configuration → Environment variables instead.

# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — adds Currents as one more headline source
CURRENTS_API_KEY=your_currents_api_key_here

# Optional — time zone whose date the 6am scheduled build uses
# EXPEDITION_TZ=America/New_York

# Optional — lets the build search Bluesky for posts about the day's story.
# Use an app password (Bluesky Settings → Privacy and security → App passwords),
# never your main password.
# BSKY_HANDLE=you.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
